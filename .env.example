# Skinport public endpoints do not require a key. Prices default to EUR.
MARKET_CURRENCY=EUR
SKINPORT_APP_ID=730
MIN_ITEM_VOLUME_24H=1
MIN_ITEM_LISTINGS=1

# YouTube: create a local OAuth token with `python scripts/auth_youtube.py`.
# Put the complete token.json contents in GitHub Actions secret YOUTUBE_TOKEN_JSON.
YOUTUBE_TOKEN_JSON=
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=20
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_MADE_FOR_KIDS=false

# Pipeline
UPLOAD_ENABLED=false
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
# Optional: use a configured ElevenLabs voice before the automatic neural fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional path to a music file you have rights to use.
CS2_MUSIC_PATH=
OUTPUT_DIR=output
DATA_DIR=data
HISTORY_DAYS=35
MARKET_IMAGE_FETCH=true
IMAGE_TIMEOUT_SECONDS=8
SKINSHOTTER_ENABLED=true
SKINSHOTTER_CLIP_SECONDS=5
LOG_LEVEL=INFO
